# Browser-safe Supabase values (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Leave true until Supabase is configured; the full demo works with local persistence.
VITE_DEMO_MODE=true

# Edge Function secrets — set with: supabase secrets set --env-file supabase/functions/.env
# Never prefix these with VITE_ or expose them in browser code.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
# Current web-search model used for jobs, people, events, and company news.
OPENAI_SEARCH_MODEL=gpt-5.6-luna

# Optional alternative to OpenAI. If OPENAI_API_KEY is absent, Claude is used.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Fine-grained token with read-only Contents and Metadata access.
# Public repositories also work without it, but with lower rate limits.
GITHUB_TOKEN=github_pat_...

# Supabase automatically injects SUPABASE_URL and server-side keys into deployed
# Edge Functions. Do not add a service-role/secret key to this root browser env.
